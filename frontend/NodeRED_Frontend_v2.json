  {
    "id": "b0ac6db8ea1a4fdf",
    "type": "function",
    "name": "X\u1eed l\u00fd Response",
    "func": "if (msg.payload && msg.payload.success) {\n    if (msg.actionType === 'set_threshold') {\n        msg.payload = \"C\u1eadp nh\u1eadt ng\u01b0\u1ee1ng c\u1ea3nh b\u00e1o th\u00e0nh c\u00f4ng!\";\n    } else if (msg.actionType === 'snooze') {\n        msg.payload = \"\u0110\u00e3 g\u1eedi l\u1ec7nh t\u1eaft c\u00f2i \u0111\u1ebfn thi\u1ebft b\u1ecb th\u00e0nh c\u00f4ng!\";\n    } else if (msg.actionType === 'reminder') {\n        msg.payload = \"\u0110\u00e3 g\u1eedi l\u1ec7nh nh\u1eafc h\u1eb9n: \" + msg.originalMessage;\n    } else {\n        msg.payload = \"L\u1ec7nh th\u1ef1c thi th\u00e0nh c\u00f4ng!\";\n    }\n} else {\n    msg.payload = \"L\u1ed7i khi g\u1ecdi API: \" + JSON.stringify(msg.payload);\n}\nreturn msg;",
    "outputs": 1,
    "x": 880,
    "y": 580,
    "wires": [
      [
        "dd03f393a9e74770"
      ]
    ]
  },
