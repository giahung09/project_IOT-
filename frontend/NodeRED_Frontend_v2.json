    "type": "function",
    "name": "X\u1eed l\u00fd d\u1eef li\u1ec7u",
    "func": "var data = msg.payload;\nvar spo2 = data.spo2;\nvar bpm = data.bpm;\nvar temp = data.temperature;\n\nreturn [\n    {payload: spo2},\n    {payload: bpm},\n    {payload: temp},\n    {payload: data}\n];",
