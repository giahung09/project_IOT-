  {
    "id": "ec1f2967db414b75",
    "type": "function",
    "name": "Format History",
    "func": "var history = msg.payload;\nif (!Array.isArray(history)) return null;\n\nvar spo2Data = [];\nvar bpmData = [];\nvar tempData = [];\n\nfor(var i=0; i<history.length; i++) {\n    var ts = history[i].timestamp * 1000;\n    // Node-RED ui_chart expects x in milliseconds\n    spo2Data.push({x: ts, y: history[i].spo2});\n    bpmData.push({x: ts, y: history[i].bpm});\n    tempData.push({x: ts, y: history[i].temperature});\n}\n\n// Format chu\u1ea9n c\u1ee7a Node-RED Dashboard cho bulk update chart\nvar chartMsg = {\n    payload: [{\n        series: [\"SpO2 (%)\", \"Nh\u1ecbp tim (BPM)\", \"Nhi\u1ec7t \u0111\u1ed9 (\u00b0C)\"],\n        data: [\n            spo2Data,\n            bpmData,\n            tempData\n        ],\n        labels: [\"SpO2\", \"BPM\", \"Nhi\u1ec7t \u0111\u1ed9\"]\n    }]\n};\n\nvar tableMsg = { payload: history };\n\nreturn [chartMsg, tableMsg];",
    "outputs": 2,
    "x": 580,
    "y": 700,
    "wires": [
      [
        "3221835da24a4362"
      ],
      [
        "db1abf53ecf14c85"
      ]
    ]
  },
