    "format": "<div style=\"height: 300px; overflow-y: auto;\">\n<table style=\"width:100%; border-collapse: collapse; font-size: 14px; text-align: left;\">\n  <tr style=\"background-color:#eee; position: sticky; top: 0;\"><th style=\"border: 1px solid #ddd; padding: 10px;\">Th\u1eddi gian</th><th style=\"border: 1px solid #ddd; padding: 10px;\">SpO2</th><th style=\"border: 1px solid #ddd; padding: 10px;\">BPM</th><th style=\"border: 1px solid #ddd; padding: 10px;\">Nhi\u1ec7t \u0111\u1ed9</th></tr>\n  <tr ng-repeat=\"row in msg.payload | orderBy:'-time'\">\n    <td style=\"border: 1px solid #ddd; padding: 10px;\">{{(row.timestamp * 1000) | date:'HH:mm:ss dd/MM/yyyy'}}</td>\n    <td style=\"border: 1px solid #ddd; padding: 10px;\">{{row.spo2}}%</td>\n    <td style=\"border: 1px solid #ddd; padding: 10px;\">{{row.bpm}}</td><td style=\"border: 1px solid #ddd; padding: 10px;\">{{row.temperature}}\u00b0C</td>\n  </tr>\n</table>\n</div>",
